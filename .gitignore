# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Built archives and indices — these belong to the user's machine, never to git.
# A PTG store is hundreds of megabytes of JSON plus a float32 matrix; committing
# one would bloat history permanently and leak whatever was indexed.
.ptg/
.code_ptg/
store_*/
*.npy
embed_cache/

# Measurement output and downloaded datasets
out/
out_code/
data/
reports_v3/
snapshots/

# Logs
logs/
*.log
ptg.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Tiny synthetic format 6 store for the migration test (4-dim vectors, two atoms)
!rev-core/tests/fixtures/store_v6/
!rev-core/tests/fixtures/store_v6/data/
!rev-core/tests/fixtures/store_v6/data/*

# Engine 0.3 work folders: environments, kit state, check caches
.venv-*/
.rptg-kit/
.hypothesis/
.mypy_cache/
.ruff_cache/
.cbmignore
# LanceDB tables (the doctests of ptgfull create small ones in the package folder)
*.lance/

# Secrets and local backups
*.pem
*.bak-ptg-*
.pytest_cache/

